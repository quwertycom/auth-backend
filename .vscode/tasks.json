{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "(dev) run app - docker",
            "type": "shell",
            "command": "docker compose -f docker-compose.dev.yml up",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "(prod) run app - docker",
            "type": "shell",
            "command": "docker compose up",
            "problemMatcher": []
        },
        {
            "label": "(dev) run app - local",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/API/API.csproj",
                "--environment",
                "Development"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "(prod) run app - local",
            "command": "dotnet",
            "type": "process",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/API/API.csproj",
                "--environment",
                "Production"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "(dev) build app - docker",
            "type": "shell",
            "command": "docker compose -f docker-compose.dev.yml build",
            "problemMatcher": []
        },
        {
            "label": "(prod) build app - docker",
            "type": "shell",
            "command": "docker compose build",
            "problemMatcher": []
        },
        {
            "label": "(dev) build app - local",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/API/API.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "(prod) build app - local",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/API/API.csproj",
                "-c",
                "Release",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "(dev) stop app - docker",
            "type": "shell",
            "command": "docker compose -f docker-compose.dev.yml down",
            "problemMatcher": []
        },
        {
            "label": "(prod) stop app - docker",
            "type": "shell",
            "command": "docker compose down",
            "problemMatcher": []
        },
        {
            "label": "(util) clean",
            "command": "dotnet",
            "type": "process",
            "args": [
                "clean",
                "${workspaceFolder}/API/API.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "(util) restore",
            "command": "dotnet",
            "type": "process",
            "args": [
                "restore",
                "${workspaceFolder}/Auth.sln"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "(util) clean-build",
            "dependsOrder": "sequence",
            "dependsOn": ["(util) clean", "(util) restore", "(dev) build app - local"],
            "problemMatcher": []
        }
    ]
} 