{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "🚀 Run Development (Docker)",
            "type": "shell",
            "command": "if [ -f .env ]; then docker compose -f docker-compose.dev.yml --env-file .env up --build; else docker compose -f docker-compose.dev.yml up --build; fi",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "🚀 Run Development (Local)",
            "dependsOrder": "sequence",
            "dependsOn": [
                "🛢️ Start Database",
                "📧 Start MailHog"
            ],
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/API/API.csproj",
                "--environment",
                "Development"
            ],
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "🚀 Run Production",
            "type": "shell",
            "command": "if [ -f .env ]; then docker compose --env-file .env up --build; else echo 'Error: .env file not found' && exit 1; fi",
            "problemMatcher": []
        },
        {
            "label": "🛠️ Build (Docker)",
            "type": "shell",
            "command": "docker compose -f docker-compose.dev.yml build",
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated"
            }
        },
        {
            "label": "🛠️ Build (Local)",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/Auth.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated"
            }
        },
        {
            "label": "🛠️ Build API (Docker)",
            "type": "shell",
            "command": "docker compose -f docker-compose.dev.yml build api",
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated"
            }
        },
        {
            "label": "🛠️ Build API (Local)",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/API/API.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated"
            }
        },
        {
            "label": "🛢️ Start Database",
            "type": "shell",
            "command": "if [ -f .env ]; then docker compose -f docker-compose.dev.yml --env-file .env up db; else docker compose -f docker-compose.dev.yml up db; fi",
            "problemMatcher": {
                "pattern": {
                    "regexp": "^.*$",
                    "file": 1,
                    "location": 2,
                    "message": 3
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*Starting.*",
                    "endsPattern": ".*database system is ready to accept connections.*"
                }
            },
            "isBackground": true,
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated"
            }
        },
        {
            "label": "📧 Start MailHog",
            "type": "shell",
            "command": "if [ -f .env ]; then docker compose -f docker-compose.dev.yml --env-file .env up mailhog -d; else docker compose -f docker-compose.dev.yml up mailhog -d; fi",
            "problemMatcher": {
                "pattern": {
                    "regexp": "^.*$",
                    "file": 1,
                    "location": 2,
                    "message": 3
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*Starting.*",
                    "endsPattern": ".*Started.*"
                }
            },
            "isBackground": true,
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated"
            }
        },
        {
            "label": "⏹️ Stop All Services",
            "type": "shell",
            "command": "if [ -f .env ]; then (docker compose -f docker-compose.dev.yml --env-file .env down && docker compose --env-file .env down); else (docker compose -f docker-compose.dev.yml down && docker compose down); fi",
            "problemMatcher": []
        },
        {
            "label": "⏹️ Stop Database",
            "type": "shell",
            "command": "if [ -f .env ]; then docker compose -f docker-compose.dev.yml --env-file .env stop db; else docker compose -f docker-compose.dev.yml stop db; fi",
            "problemMatcher": []
        },
        {
            "label": "🧹 Build Project",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/API/API.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated"
            }
        },
        {
            "label": "🔄 Clean & Rebuild",
            "dependsOrder": "sequence",
            "dependsOn": [
                "🧹 Clean",
                "📦 Restore Packages",
                "🧹 Build Project"
            ],
            "problemMatcher": []
        },
        {
            "label": "🧹 Clean",
            "command": "dotnet",
            "type": "process",
            "args": [
                "clean",
                "${workspaceFolder}/API/API.csproj"
            ],
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated"
            }
        },
        {
            "label": "📦 Restore Packages",
            "command": "dotnet",
            "type": "process",
            "args": [
                "restore",
                "${workspaceFolder}/Auth.sln"
            ],
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated"
            }
        },
        {
            "label": "🧪 Run All Tests",
            "command": "dotnet",
            "type": "process",
            "args": [
                "test",
                "${workspaceFolder}/Auth.sln",
                "--logger:trx"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "🧪 Run Unit Tests",
            "command": "dotnet",
            "type": "process",
            "args": [
                "test",
                "${workspaceFolder}/Tests/API.UnitTests/API.UnitTests.csproj",
                "--logger:trx"
            ],
            "problemMatcher": "$msCompile",
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "🧪 Run Integration Tests",
            "dependsOrder": "sequence",
            "command": "dotnet",
            "type": "process",
            "args": [
                "test",
                "${workspaceFolder}/Tests/API.IntegrationTests/API.IntegrationTests.csproj",
                "--logger:trx"
            ],
            "problemMatcher": "$msCompile",
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "🧪 Run Functional Tests",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Start API for Functional Tests"
            ],
            "command": "dotnet",
            "type": "process",
            "args": [
                "test",
                "${workspaceFolder}/Tests/API.FunctionalTests/API.FunctionalTests.csproj",
                "--logger:trx"
            ],
            "problemMatcher": "$msCompile",
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "Start API for Functional Tests",
            "type": "shell",
            "command": "if [ -f .env ]; then docker compose -f docker-compose.dev.yml --env-file .env up --build -d api; else docker compose -f docker-compose.dev.yml up --build -d api; fi",
            "problemMatcher": {
                "pattern": {
                    "regexp": "^.*$",
                    "file": 1,
                    "location": 2,
                    "message": 3
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*Starting.*",
                    "endsPattern": ".*Application started.*"
                }
            },
            "isBackground": true,
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated"
            },
            "hide": true
        },
        {
            "label": "🧪 Run Performance Tests",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Start API for Performance Tests"
            ],
            "command": "dotnet",
            "type": "process",
            "args": [
                "test",
                "${workspaceFolder}/Tests/API.PerformanceTests/API.PerformanceTests.csproj",
                "--logger:trx"
            ],
            "problemMatcher": "$msCompile",
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "Start API for Performance Tests",
            "type": "shell",
            "command": "if [ -f .env ]; then docker compose -f docker-compose.dev.yml --env-file .env up --build -d api; else docker compose -f docker-compose.dev.yml up --build -d api; fi",
            "problemMatcher": {
                "pattern": {
                    "regexp": "^.*$",
                    "file": 1,
                    "location": 2,
                    "message": 3
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*Starting.*",
                    "endsPattern": ".*Application started.*"
                }
            },
            "isBackground": true,
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated"
            },
            "hide": true
        },
        {
            "label": "🧪 Format Code",
            "command": "dotnet",
            "type": "process",
            "args": [
                "format",
                "${workspaceFolder}/Auth.sln",
                "--verify-no-changes",
                "--verbosity",
                "detailed"
            ],
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "group": "none"
        },
        {
            "label": "🎨 Format Code (Fix)",
            "command": "dotnet",
            "type": "process",
            "args": [
                "format",
                "${workspaceFolder}/Auth.sln",
                "--verbosity",
                "detailed"
            ],
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "group": "none"
        },
        {
            "label": "🔄 Update Database",
            "type": "shell",
            "command": "if [ -f ${workspaceFolder}/.env ]; then export $(cat ${workspaceFolder}/.env | grep -v '^#' | xargs) && export DATABASE_HOST=localhost && cd ${workspaceFolder}/API && dotnet ef database update; else echo 'Error: .env file not found' && exit 1; fi",
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "🔄 Add Migration",
            "type": "shell",
            "command": "if [ -f ${workspaceFolder}/.env ]; then export $(cat ${workspaceFolder}/.env | grep -v '^#' | xargs) && cd ${workspaceFolder}/API && dotnet ef migrations add ${input:migrationName}; else echo 'Error: .env file not found' && exit 1; fi",
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "🔄 Remove Last Migration",
            "type": "shell",
            "command": "if [ -f ${workspaceFolder}/.env ]; then export $(cat ${workspaceFolder}/.env | grep -v '^#' | xargs) && export DATABASE_HOST=localhost && cd ${workspaceFolder}/API && dotnet ef migrations remove --force; else echo 'Error: .env file not found' && exit 1; fi",
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        }
    ],
    "inputs": [
        {
            "id": "migrationName",
            "type": "promptString",
            "description": "Name of the migration",
            "default": "NewMigration"
        }
    ]
}