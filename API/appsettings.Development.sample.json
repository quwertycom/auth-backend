{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JWT": {
    "SecretKey": "development-secret-key-minimum-32-chars-long-here",
    "Issuer": "auth-backend-dev",
    "Audience": "auth-client-dev"
  },
  "Snowflake": {
    "DatacenterId": 1,
    "WorkerId": 1,
    "Epoch": "2024-01-01T00:00:00Z"
  },
  "PasswordHasher": {
    "Iterations": 10000,
    "SaltSize": 16,
    "KeySize": 32
  },
  "Email": {
    "Host": "smtp.mail.com",
    "Port": 587,
    "EnableSsl": true,
    "Username": "your-email@example.com",
    "Password": "your-email-password",
    "FromEmail": "your-email@example.com"
  }
}
