{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Snowflake": {
    "Epoch": "2024-01-01T00:00:00Z"
  },
  "Frontend": {
    "BaseUrl": "https://your-frontend-domain.com"
  },
  "ApiSettings": {
    "Port": "8000"
  },
  "RateLimiting": {
    "PermitLimit": 20,
    "SegmentsPerWindow": 4,
    "WindowInMinutes": 1
  }
}
