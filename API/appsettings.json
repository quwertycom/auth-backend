{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Host": "",
    "Port": 5432
  },
  "Jwt": {
    "Issuer": "auth-backend",
    "Audience": "auth-client"
  },
  "PasswordHasher": {
    "Iterations": 10000,
    "SaltSize": 16,
    "KeySize": 32
  },
  "Snowflake": {
    "DatacenterId": 1,
    "WorkerId": 1,
    "Epoch": "2024-01-01T00:00:00Z"
  },
  "Email": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "EnableSsl": true,
    "Timeout": 30000,
    "UseDefaultCredentials": false
  }
}
