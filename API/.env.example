# Database Settings
POSTGRES_USER=your-username
POSTGRES_PASSWORD=your-password
POSTGRES_DB=your-database-name

# JWT Settings
JWT:SecretKey=your-secret-key-minimum-32-chars-long
JWT:Issuer=your-issuer
JWT:Audience=your-audience

# Email Settings
Email:Host=smtp.example.com
Email:Port=587
Email:EnableSsl=true
Email:Username=your-email@example.com
Email:Password=your-email-password
Email:FromEmail=your-sender-email@example.com

# Other Secrets
# Add any other secrets your application needs here 