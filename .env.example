# Database Settings
ENV__DB__HOST=example_host
ENV__DB__DATABASE=example_database
ENV__DB__USERNAME=example_user
ENV__DB__PASSWORD=example_password

# JWT Settings
ENV__JWT__SECRET_KEY=example-secret-key-minimum-32-chars-long
ENV__JWT__ISSUER=example-issuer
ENV__JWT__AUDIENCE=example-audience

# Email Settings
ENV__EMAIL__HOST=smtp.example.com
ENV__EMAIL__PORT=587
ENV__EMAIL__ENABLE_SSL=true
ENV__EMAIL__USERNAME=example_email@gmail.com
ENV__EMAIL__PASSWORD=example_email_password
ENV__EMAIL__FROM_EMAIL=example_email@gmail.com 

# PasswordHasher Settings
ENV__PASSWORD_HASHER__ITERATIONS=10000
ENV__PASSWORD_HASHER__SALT_SIZE=16
ENV__PASSWORD_HASHER__KEY_SIZE=32

# Snowflake Settings
ENV__SNOWFLAKE__DATACENTER_ID=1
ENV__SNOWFLAKE__WORKER_ID=1
ENV__SNOWFLAKE__EPOCH=2024-01-01T00:00:00Z